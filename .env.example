# ==========================================
# STOK & MAKİNE BAKIM TAKİP SİSTEMİ - .env
# ==========================================

# 1. PostgreSQL Veritabanı Bağlantı Dizesi (Railway otomatik sağlar)
# Örnek: postgresql://postgres:sifre@junction.proxy.rlwy.net:12345/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# 2. Port ve Sunucu Ayarları (Railway dinamik olarak $PORT atar)
PORT=8000
HOST=0.0.0.0

# 3. Otomatik Tohumlama (Veritabanı boşsa örnek kayıtları yükle: true / false)
AUTO_SEED=true

# 4. Yaklaşan Bakım Eşiği (Gün)
UPCOMING_MAINTENANCE_DAYS_THRESHOLD=7
