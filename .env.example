# ==========================================
# STOK & MAKİNE BAKIM TAKİP SİSTEMİ - .env
# ==========================================

# PostgreSQL Veritabanı Bağlantı Dizesi (Railway otomatik atar)
# Örnek: postgresql://postgres:password@localhost:5432/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Uygulama Portu (Railway tarafından dinamik atanır, yerel için 8000)
PORT=8000
HOST=0.0.0.0

# İlk dağıtımda veritabanı boşsa örnek verileri yükle (true / false)
AUTO_SEED=true

# Yaklaşan bakım eşiği (gün)
UPCOMING_MAINTENANCE_DAYS_THRESHOLD=7
