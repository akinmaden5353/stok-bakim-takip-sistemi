# ==========================================
# STOK & MAKİNE BAKIM TAKİP SİSTEMİ - .env
# ==========================================

# 1. PostgreSQL Veritabanı Bağlantı Dizesi
# Yerel PostgreSQL Örneği:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/bakim_db

# Azure Database for PostgreSQL Flexible Server Örneği:
DATABASE_URL=postgresql://bakimadmin:Sifreniz123!@pg-stok-bakim.postgres.database.azure.com:5432/bakim_db?sslmode=require

# Railway Örneği:
# DATABASE_URL=postgresql://postgres:password@junction.proxy.rlwy.net:12345/railway

# 2. Port ve Sunucu Ayarları
# Azure App Service otomatik olarak WEBSITES_PORT=8000 veya PORT kullanır.
PORT=8000
HOST=0.0.0.0
WEBSITES_PORT=8000

# 3. Otomatik Tohumlama (Veritabanı boşsa örnek kayıtları yükle)
AUTO_SEED=true

# 4. Yaklaşan Bakım Eşiği (Gün)
UPCOMING_MAINTENANCE_DAYS_THRESHOLD=7
